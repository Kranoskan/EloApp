<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="?attr/android:windowBackground"
            android:gravity="center_horizontal">

            <!-- Gráfica de Evolución de Fuerza -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorSecondary"
                android:layout_marginBottom="16dp">

                <com.example.myapplication.ui.player.StrengthGraphView
                    android:id="@+id/graphStrength"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Título del Juego -->
            <TextView
                android:id="@+id/tvPlayerGameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Catan"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="4dp"
                android:textAlignment="center"/>

            <!-- Subtítulo con Nombre del Jugador -->
            <TextView
                android:id="@+id/tvPlayerGameSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Estadísticas de Juan"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="12dp"
                android:textAlignment="center"/>

            <!-- Badge de Partidas Jugadas por el Jugador -->
            <TextView
                android:id="@+id/tvPlayerGameMatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Partidas Jugadas: 7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/bg_board_game_token"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="24dp"/>

            <!-- Sección: Turnos -->
            <LinearLayout
                android:id="@+id/llSectionTurns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvTurnsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚔️ Turnos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="8dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/llTurnsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <!-- Sección: Equipos -->
            <LinearLayout
                android:id="@+id/llSectionTeams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvTeamsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👥 Equipos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="8dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/llTeamsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <!-- Sección: Modificadores de Reglas / Roles -->
            <LinearLayout
                android:id="@+id/llSectionRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvRulesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📜 Modificadores de Reglas/Roles"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="8dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/llRulesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <!-- Sección: Expansiones y Mapas -->
            <LinearLayout
                android:id="@+id/llSectionExpansions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvExpansionsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗺️ Expansiones y Mapas"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="8dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/llExpansionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="?attr/colorPrimary"
        android:contentDescription="Cerrar"
        android:padding="12dp"/>
</FrameLayout>
